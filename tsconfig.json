{
	"compilerOptions": {
	  "module": "Node16",  
	  "moduleResolution": "Node16",  
	  "esModuleInterop": true,  
	  "allowSyntheticDefaultImports": true,  
	  "target": "ESNext", 
	  "strict": true, 
	  "skipLibCheck": true,  
	  "resolveJsonModule": true,  
	  "outDir": "./dist"  
	},
	"include": [
	  "src/**/*"  
	],
	"exclude": [
	  "node_modules" 
	]
  }
  